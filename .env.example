# Copia este archivo a .env y cambia las contraseñas. El .env nunca se sube al repo.

# --- PostgreSQL local (docker compose) ---
POSTGRES_PASSWORD=cambia-esto-postgres
GESTION_OWNER_PASSWORD=cambia-esto-owner
GESTION_APP_PASSWORD=cambia-esto-app
SITIO_LECTURA_PASSWORD=cambia-esto-sitio

# --- API ---
# La API corre como gestion_app; las migraciones y la semilla, como gestion_owner.
# Postgres local escucha en el 5433 para no chocar con otro Postgres de la máquina.
DATABASE_URL=postgres://gestion_app:cambia-esto-app@localhost:5433/gestion
DATABASE_URL_MIGRACIONES=postgres://gestion_owner:cambia-esto-owner@localhost:5433/gestion
PUERTO=3000

# Acceso: "access" en producción (Cloudflare Access) y "desarrollo" en tu máquina.
# En desarrollo el usuario es DEV_CORREO, o el que mande la cabecera X-Dev-Correo.
AUTH_MODO=desarrollo
DEV_CORREO=admin@unavezmasmx.com
# Solo con AUTH_MODO=access:
# CF_ACCESS_TEAM=https://<tu-team>.cloudflareaccess.com
# CF_ACCESS_AUD=<aud-de-la-aplicacion>

# --- Semilla: el primer administrador ---
ADMIN_INICIAL_CORREO=admin@unavezmasmx.com
ADMIN_INICIAL_NOMBRE=Administrador
