# El .env del servidor de producción. Cópialo como .env allá, llena los valores y
# déjalo solo para su dueño:  chmod 600 .env
#
# Las contraseñas se generan con `openssl rand -hex 24` y llevan solo letras y
# números: van dentro de URLs de conexión. Nunca salen del servidor.
# Guía completa: docs/despliegue.md

# Siempre el archivo de producción, aunque se teclee `docker compose` a secas.
COMPOSE_FILE=compose.prod.yml

# La imagen exacta que se despliega (nunca `latest`): así se sabe qué está corriendo
# y se puede volver a la anterior.
IMAGEN=ghcr.io/gearspeed/una-vez-mas-gestion:<sha-del-commit>

# --- PostgreSQL ---
POSTGRES_PASSWORD=
GESTION_OWNER_PASSWORD=
GESTION_APP_PASSWORD=
SITIO_LECTURA_PASSWORD=

# --- Cloudflare ---
CLOUDFLARE_TUNNEL_TOKEN=
CF_ACCESS_TEAM=https://<tu-team>.cloudflareaccess.com
CF_ACCESS_AUD=

# --- Imágenes de producto (Object Storage de Contabo) ---
S3_ENDPOINT=https://usc1.contabostorage.com
S3_REGION=default
S3_BUCKET=imagenes
S3_ACCESS_KEY=
S3_SECRET_KEY=
IMAGENES_URL_PUBLICA=https://usc1.contabostorage.com/<cuenta>:imagenes

# --- Primer administrador (lo usa la semilla) ---
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_NOMBRE=Administrador

# --- Opcionales ---
# Peticiones por minuto y por usuario (o por IP sin sesión).
# LIMITE_PETICIONES=300
# LOG_NIVEL=info
# Configuración de rclone para el respaldo, y un vigilante que avise si deja de correr.
# RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# RESPALDOS_PING=https://hc-ping.com/<tu-uuid>
