{
  "name": "@uvm/api",
  "version": "0.1.0",
  "private": true,
  "description": "API del aplicativo: NestJS + Drizzle + PostgreSQL",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "generar-migracion": "drizzle-kit generate",
    "migrar": "tsx src/cli/migrar.ts",
    "semilla": "tsx src/cli/semilla.ts",
    "preparar-bucket": "tsx src/cli/preparar-bucket.ts",
    "subir-imagenes": "tsx src/cli/subir-imagenes.ts",
    "test": "vitest run",
    "test:integracion": "vitest run --config vitest.integracion.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/throttler": "^6.7.0",
    "@uvm/compartido": "*",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@testcontainers/minio": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11"
  }
}
